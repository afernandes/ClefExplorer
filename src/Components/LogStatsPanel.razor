@using ClefExplorer.Models
@using ClefExplorer.Helpers
@using Omni.Blazor.Models

@* Visão agregada do conjunto FILTRADO — não do arquivo inteiro. Assim as estatísticas
   respondem ao que está em tela: filtrou por período, os números acompanham.

   Tudo aqui é clicável e aplica o filtro correspondente: é o que transforma o painel
   de "relatório" em ponto de partida da investigação. *@

<div class="clef-stats">
    @if (Stats.Total == 0)
    {
        <div class="clef-center">
            <OmniEmptyState Icon="bar-chart" Title="Nada para analisar" />
        </div>
    }
    else
    {
        <div class="clef-stats-grid">

            @* --- Resumo -------------------------------------------------------- *@
            <OmniCard Title="Resumo" Class="clef-stats-card">
                <div class="clef-stat-numbers">
                    <div class="clef-stat-big">
                        <span class="clef-stat-value">@Stats.Total.ToString("N0")</span>
                        <span class="clef-stat-label">eventos</span>
                    </div>
                    <div class="clef-stat-big @(Stats.ErrorCount > 0 ? "is-error" : "")">
                        <span class="clef-stat-value">@Stats.ErrorCount.ToString("N0")</span>
                        <span class="clef-stat-label">erros e fatais</span>
                    </div>
                    <div class="clef-stat-big">
                        <span class="clef-stat-value">@PercentualErro</span>
                        <span class="clef-stat-label">taxa de erro</span>
                    </div>
                </div>

                <div class="clef-stat-bars">
                    @foreach (var nivel in Stats.ByLevel)
                    {
                        var n = nivel;
                        <button type="button" class="clef-stat-row" title="Filtrar por @n.Label"
                                @onclick="@(() => OnFilterLevel.InvokeAsync(n.Key))">
                            <OmniBadge Text="@n.Label" Variant="@LogLevelStyles.Variant(n.Key)" Size="ComponentSize.Sm" />
                            <span class="clef-stat-track"><span class="clef-stat-fill" style="@Largura(n.Count, MaiorNivel)"></span></span>
                            <span class="clef-stat-count">@n.Count.ToString("N0")</span>
                        </button>
                    }
                </div>
            </OmniCard>

            @* --- Timeline ------------------------------------------------------ *@
            <OmniCard Title="@($"Ao longo do tempo ({RotuloFatia})")" Class="clef-stats-card clef-stats-wide">
                @if (Stats.Timeline.Count > 0)
                {
                    <OmniChart Series="@SerieTimeline"
                               Height="180px"
                               LegendPosition="ChartLegendPosition.Top"
                               ColorScheme="ChartColorScheme.Semantic"
                               AriaLabel="Eventos e erros ao longo do tempo" />
                }
            </OmniCard>

            @* --- Rankings ------------------------------------------------------ *@
            <OmniCard Title="Origens mais frequentes" Class="clef-stats-card">
                <LogRanking Entradas="Stats.TopSources" OnSelect="@(chave => OnFilterRanking.InvokeAsync(new FiltroRanking(TipoFiltroRanking.Origem, chave)))" />
            </OmniCard>

            <OmniCard Title="Mensagens mais repetidas" Class="clef-stats-card">
                <LogRanking Entradas="Stats.TopMessages" OnSelect="@(chave => OnFilterRanking.InvokeAsync(new FiltroRanking(TipoFiltroRanking.Mensagem, chave)))" />
            </OmniCard>

            @if (Stats.TopExceptions.Count > 0)
            {
                <OmniCard Title="Exceções mais frequentes" Class="clef-stats-card clef-stats-wide">
                    <LogRanking Entradas="Stats.TopExceptions" OnSelect="@(chave => OnFilterRanking.InvokeAsync(new FiltroRanking(TipoFiltroRanking.Excecao, chave)))" />
                </OmniCard>
            }
        </div>
    }
</div>
