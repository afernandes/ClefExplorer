@using ClefExplorer.Services
@inject SettingsService SettingsService
@inject FileAssociationService FileAssociationService
@inject DialogService Dialog

<div>
    <div class="clef-dialog-section">
        <h6>Ignorar Arquivos (Padrões)</h6>
        <p class="clef-dialog-hint">Ex: NomeArquivo.*.clef</p>
        <div class="clef-input-row">
            <OmniTextBox Value="@NewFilePattern" ValueChanged="@(v => NewFilePattern = v ?? "")" Placeholder="Novo padrão..." OnKeyDown="OnFilePatternKey" />
            <OmniButton Text="Adicionar" Variant="ButtonVariant.Primary" OnClick="AddFilePattern" />
        </div>
        <div class="clef-tag-list">
            @foreach (var pattern in SettingsService.Settings.IgnoredFilePatterns)
            {
                var p = pattern;
                <div class="clef-tag-row" @key="p">
                    <span class="clef-mono">@p</span>
                    <OmniButton Icon="trash" IconOnly="true" Variant="ButtonVariant.Danger" Size="ComponentSize.Sm" OnClick="@(() => RemoveFilePattern(p))" />
                </div>
            }
        </div>
    </div>

    <details class="clef-dialog-section clef-dialog-disclosure">
        <summary>
            <span>
                <strong>Correlação de eventos</strong>
                <small>Aliases equivalentes a CorrelationId</small>
            </span>
            <OmniIcon Name="chevron-down" Size="ComponentSize.Sm" />
        </summary>
        <div class="clef-dialog-disclosure-content">
            <p class="clef-dialog-hint">
                TraceId, SpanId e RequestId são reconhecidos sempre. Os campos abaixo são
                tratados como o mesmo CorrelationId, mesmo quando aplicações diferentes usam
                nomes distintos.
            </p>
            <ObservabilityAliasEditor Title="Campos de correlação"
                                      Hint="Ex.: X-Correlation-Id, CorrelationId"
                                      Values="SettingsService.Settings.Correlacao.Campos"
                                      OnChanged="SaveCorrelation" />
        </div>
    </details>

    <details class="clef-dialog-section clef-dialog-disclosure">
        <summary>
            <span>
                <strong>Integração OpenTelemetry / Seq</strong>
                <small>Aliases para campos personalizados</small>
            </span>
            <OmniIcon Name="chevron-down" Size="ComponentSize.Sm" />
        </summary>
        <div class="clef-dialog-disclosure-content">
            <p class="clef-dialog-hint">
                Os campos padrão Seq/CLEF e os campos OTLP presentes nos eventos são
                reconhecidos automaticamente. Configure aliases somente quando sua aplicação
                usar outros nomes de propriedades.
            </p>
            <ObservabilityAliasEditor Title="Nome da operação"
                                      Hint="Ex.: OperationName, SpanName"
                                      Values="SettingsService.Settings.Observabilidade.CamposNomeOperacao"
                                      OnChanged="SaveObservability" />
            <ObservabilityAliasEditor Title="Nome do serviço"
                                      Hint="Ex.: service.name, Application"
                                      Values="SettingsService.Settings.Observabilidade.CamposNomeServico"
                                      OnChanged="SaveObservability" />
            <ObservabilityAliasEditor Title="Tipo do span"
                                      Hint="Ex.: ActivityKind, SpanKind"
                                      Values="SettingsService.Settings.Observabilidade.CamposTipoSpan"
                                      OnChanged="SaveObservability" />
            <ObservabilityAliasEditor Title="Duração informada"
                                      Hint="Ex.: Duration, Elapsed; o valor precisa conter unidade"
                                      Values="SettingsService.Settings.Observabilidade.CamposDuracao"
                                      OnChanged="SaveObservability" />
        </div>
    </details>

    <div class="clef-dialog-section">
        <h6>Ignorar Linhas de Log (Contém Texto)</h6>
        <p class="clef-dialog-hint">Ex: HealthCheck</p>
        <div class="clef-input-row">
            <OmniTextBox Value="@NewLogLine" ValueChanged="@(v => NewLogLine = v ?? "")" Placeholder="Texto a ignorar..." OnKeyDown="OnLogLineKey" />
            <OmniButton Text="Adicionar" Variant="ButtonVariant.Primary" OnClick="AddLogLine" />
        </div>
        <div class="clef-tag-list">
            @foreach (var line in SettingsService.Settings.IgnoredLogLines)
            {
                var l = line;
                <div class="clef-tag-row" @key="l">
                    <span class="clef-mono">@l</span>
                    <OmniButton Icon="trash" IconOnly="true" Variant="ButtonVariant.Danger" Size="ComponentSize.Sm" OnClick="@(() => RemoveLogLine(l))" />
                </div>
            }
        </div>
    </div>

    <div class="clef-dialog-section">
        <h6>Associação de Arquivos</h6>
        <p class="clef-dialog-hint">Definir este aplicativo como padrão para arquivos .clef e .clef.gz</p>
        @if (_isDefaultApp)
        {
            <OmniAlert Severity="NotificationSeverity.Success" Icon="circle-check">Este aplicativo já é o padrão.</OmniAlert>
        }
        else
        {
            <OmniButton Text="Definir como padrão" Variant="ButtonVariant.Primary" OnClick="SetAsDefaultApp" />
        }
    </div>

    <div style="text-align:center; color:var(--omni-fg-muted); font-size:12px; margin-top:8px;">
        Versão @System.Reflection.Assembly.GetExecutingAssembly().GetName().Version
    </div>

    <div class="omni-row omni-row-end omni-row-gap-8" style="margin-top:12px;">
        <OmniButton Text="Fechar" OnClick="@(() => Dialog.Close((object?)null))" />
    </div>
</div>

@code {
    private string NewFilePattern { get; set; } = "";
    private string NewLogLine { get; set; } = "";
    private bool _isDefaultApp;

    protected override void OnInitialized() => CheckDefaultApp();

    private void CheckDefaultApp()
    {
        try { _isDefaultApp = FileAssociationService.IsDefaultHandler(); }
        catch { _isDefaultApp = false; }
    }

    private void OnFilePatternKey(KeyboardEventArgs e) { if (e.Key == "Enter") AddFilePattern(); }
    private void OnLogLineKey(KeyboardEventArgs e) { if (e.Key == "Enter") AddLogLine(); }

    private void AddFilePattern()
    {
        if (!string.IsNullOrWhiteSpace(NewFilePattern))
        {
            if (!SettingsService.Settings.IgnoredFilePatterns.Contains(NewFilePattern))
            {
                SettingsService.Settings.IgnoredFilePatterns.Add(NewFilePattern);
                SettingsService.Save();
            }
            NewFilePattern = "";
        }
    }

    private void RemoveFilePattern(string pattern)
    {
        SettingsService.Settings.IgnoredFilePatterns.Remove(pattern);
        SettingsService.Save();
    }

    private void AddLogLine()
    {
        if (!string.IsNullOrWhiteSpace(NewLogLine))
        {
            if (!SettingsService.Settings.IgnoredLogLines.Contains(NewLogLine))
            {
                SettingsService.Settings.IgnoredLogLines.Add(NewLogLine);
                SettingsService.Save();
            }
            NewLogLine = "";
        }
    }

    private void RemoveLogLine(string line)
    {
        SettingsService.Settings.IgnoredLogLines.Remove(line);
        SettingsService.Save();
    }

    private void SaveObservability() => SettingsService.Save();

    private void SaveCorrelation() => SettingsService.Save();

    private void SetAsDefaultApp()
    {
        FileAssociationService.SetAsDefault();
        CheckDefaultApp();
    }
}
