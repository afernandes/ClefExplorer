@using System.Threading
@using ClefExplorer.Models
@using ClefExplorer.Services
@implements IDisposable

@inject LogStore Store
@inject LogGroupService GroupService
@inject IFilePickerService FilePicker
@inject FileAssociationService FileAssociationService
@inject SettingsService SettingsService
@inject DialogService Dialog
@inject NotificationService Notifications

<div class="clef-root">
    <LogHeader @bind-TextoPesquisa="TextoPesquisa"
               @bind-QuantidadeRegistros="QuantidadeRegistros"
               OnReload="Carregar" />

    @if (_showDefaultAppNotification)
    {
        <OmniBanner Severity="NotificationSeverity.Warning" Dismissible="true" OnClosed="DismissNotification">
            <ChildContent>
                O Clef Explorer não é o aplicativo padrão para arquivos de log (.clef).
            </ChildContent>
            <Actions>
                <OmniButton Text="Definir como padrão" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="SetAsDefaultApp" />
            </Actions>
        </OmniBanner>
    }

    <div class="clef-body">
        <OmniSplitter Orientation="Orientation.Horizontal" Variant="SplitterVariant.Line">
            <OmniSplitterPane Size="260px" Min="200px" Max="600px">
                <div class="clef-pane">
                    <LogSidebar @bind-FiltroRapido="FiltroRapido"
                                @bind-VisibleFiles="VisibleFiles"
                                @bind-DataInicial="DataInicial"
                                @bind-DataFinal="DataFinal"
                                LoadedFiles="@Store.LoadedFiles"
                                AvailableFiles="@Store.AvailableFiles"
                                LogGroups="@GroupService.Groups"
                                OnOpenFile="AbrirArquivoDialog"
                                OnOpenFolder="AbrirPastaDialog"
                                OnOpenGroup="AbrirGrupo"
                                OnManageGroups="AbrirGerenciadorGrupos"
                                OnOpenSettings="AbrirConfiguracoes" />
                </div>
            </OmniSplitterPane>

            <OmniSplitterPane>
                <div class="clef-main">
                    <LogToolbar Subtitulo="@Subtitulo"
                                @bind-CurrentPage="Pagina"
                                TotalCount="@_todosEventos.Count"
                                PageSize="@QuantidadeRegistros"
                                OnExport="ExportarFiltrados"
                                TailEnabled="@Store.TailEnabled"
                                OnToggleTail="AlternarAoVivo"
                                IsLoading="@Store.IsLoading"
                                OnCancelLoad="CancelarCarregamento" />

                    <div class="clef-body">
                        @* Sem seleção: lista ocupa todo o espaço (sem splitter, evitando a
                           race de medição do OmniSplitter aninhado no estado de 1 pane).
                           Com seleção: splitter lista|detalhe — criado quando o pane pai já
                           tem largura, então a medição funciona. *@
                        @if (_selected != null)
                        {
                            <OmniSplitter Orientation="Orientation.Horizontal" Variant="SplitterVariant.Line">
                                <OmniSplitterPane Min="320px">
                                    <div class="clef-pane">
                                        <LogList IsBusy="@_isBusy"
                                                 Eventos="@_eventos"
                                                 SelectedEvent="@_selected"
                                                 OnSelect="Select" />
                                    </div>
                                </OmniSplitterPane>
                                <OmniSplitterPane Size="45%" Min="320px">
                                    <div class="clef-pane">
                                        <LogDetails SelectedEvent="@_selected" OnClose="CloseDetail" OnFilter="FiltrarPorTexto" />
                                    </div>
                                </OmniSplitterPane>
                            </OmniSplitter>
                        }
                        else
                        {
                            <div class="clef-pane">
                                <LogList IsBusy="@_isBusy"
                                         Eventos="@_eventos"
                                         SelectedEvent="@_selected"
                                         OnSelect="Select" />
                            </div>
                        }
                    </div>
                </div>
            </OmniSplitterPane>
        </OmniSplitter>
    </div>
</div>

@code {
    private ClefEvent? _selected;
    private bool _isBusy;
    private List<ClefEvent> _todosEventos = new();
    private List<ClefEvent> _eventos = new();
    private int _quantidadeRegistros = 50;
    private int _pagina = 1;
    private string _textoPesquisa = string.Empty;
    private string _filtroRapido = "Todos";
    private HashSet<string>? _visibleFiles;
    private DateTime? _dataInicial;
    private DateTime? _dataFinal;
    private CancellationTokenSource? _filterCts;
    private bool _showDefaultAppNotification;

    private int QuantidadeRegistros
    {
        get => _quantidadeRegistros;
        set
        {
            _quantidadeRegistros = value;
            Pagina = 1;
            AtualizarPagina();
        }
    }

    private int Pagina
    {
        get => _pagina;
        set
        {
            _pagina = Math.Clamp(value, 1, UltimaPagina);
            AtualizarPagina();
        }
    }

    private int UltimaPagina => Math.Max(1, (int)Math.Ceiling((_todosEventos.Count) / (double)QuantidadeRegistros));
    private string Subtitulo => _todosEventos.Count > 0
        ? $"{Math.Min((Pagina - 1) * QuantidadeRegistros + 1, _todosEventos.Count)}-{Math.Min(Pagina * QuantidadeRegistros, _todosEventos.Count)} de {_todosEventos.Count}"
        : "0 de 0";

    private string TextoPesquisa
    {
        get => _textoPesquisa;
        set
        {
            _textoPesquisa = value;
            // Debounce: sem ele, cada tecla varria todos os eventos. A filtragem anterior
            // até era cancelada, mas o agendamento e a re-renderização continuavam custando.
            AgendarFiltragem();
        }
    }

    private CancellationTokenSource? _debounceCts;
    private static readonly TimeSpan DebounceBusca = TimeSpan.FromMilliseconds(250);

    private void AgendarFiltragem()
    {
        var cts = new CancellationTokenSource();
        var anterior = Interlocked.Exchange(ref _debounceCts, cts);
        if (anterior is not null)
        {
            try { anterior.Cancel(); } catch (ObjectDisposedException) { }
            anterior.Dispose();
        }

        _ = EsperarEFiltrar(cts);
    }

    private async Task EsperarEFiltrar(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DebounceBusca, cts.Token);
            await AplicarFiltrosAsync();
        }
        catch (OperationCanceledException)
        {
            // Outra tecla chegou antes do prazo: esta filtragem foi descartada.
        }
        finally
        {
            Interlocked.CompareExchange(ref _debounceCts, null, cts);
            cts.Dispose();
        }
    }

    private string FiltroRapido
    {
        get => _filtroRapido;
        set
        {
            if (_filtroRapido != value)
            {
                _filtroRapido = value;
                AplicarFiltros();
            }
        }
    }

    private HashSet<string>? VisibleFiles
    {
        get => _visibleFiles;
        set
        {
            if (_visibleFiles != value)
            {
                _visibleFiles = value;
                if (_visibleFiles != null)
                {
                    _ = Store.UpdateLoadedFiles(_visibleFiles);
                }
                AplicarFiltros();
            }
        }
    }

    private DateTime? DataInicial
    {
        get => _dataInicial;
        set
        {
            if (_dataInicial != value)
            {
                _dataInicial = value;
                AplicarFiltros();
            }
        }
    }

    private DateTime? DataFinal
    {
        get => _dataFinal;
        set
        {
            if (_dataFinal != value)
            {
                _dataFinal = value;
                AplicarFiltros();
            }
        }
    }

    protected override void OnInitialized()
    {
        // Handlers nomeados (não lambdas) para poderem ser desinscritos no Dispose:
        // LogStore e LogGroupService são singletons, então um handler não removido
        // mantém este componente vivo enquanto o app existir.
        Store.Changed += OnStoreChanged;
        Store.PathsLoaded += OnPathsLoaded;
        GroupService.Changed += OnGroupsChanged;

        if (Store.IsLoading)
        {
            _isBusy = true;
        }
        else if (Store.Count > 0)
        {
            AplicarFiltros();
        }

        CheckDefaultApp();
        ReportarErrosDeInicializacao();
    }

    /// <summary>
    /// Os serviços de configuração são construídos pela DI antes de existir UI, então um
    /// arquivo inválido ou uma pasta sem permissão só pode ser reportado aqui. Antes esses
    /// erros eram engolidos e o usuário via a configuração simplesmente "sumir".
    /// </summary>
    private void ReportarErrosDeInicializacao()
    {
        if (SettingsService.LastError is { } erroConfig)
        {
            Notifications.Error("Configurações", erroConfig);
        }

        if (GroupService.LastError is { } erroGrupos)
        {
            Notifications.Error("Grupos de log", erroGrupos);
        }
    }

    /// <summary>Avisa sobre arquivos que não puderam ser lidos no último carregamento.</summary>
    private void ReportarFalhasDeLeitura()
    {
        var falhas = Store.LoadFailures;
        if (falhas.Count == 0) return;

        var resumo = falhas.Count == 1
            ? "1 arquivo não pôde ser lido"
            : $"{falhas.Count} arquivos não puderam ser lidos";

        // Detalhar até 3 para a mensagem não virar uma parede de texto; o restante
        // fica no log de diagnóstico do app.
        var detalhe = string.Join("\n", falhas.Take(3).Select(f => $"{Path.GetFileName(f.Path)}: {f.Reason}"));
        if (falhas.Count > 3)
        {
            detalhe += $"\n(e mais {falhas.Count - 3}; veja {AppLog.FilePath})";
        }

        Notifications.Warning(resumo, detalhe);
    }

    private void OnStoreChanged() => _ = InvokeAsync(() =>
    {
        // NÃO resetar _visibleFiles aqui: este evento também dispara durante
        // UpdateLoadedFiles (ao (des)marcar arquivos na árvore), e zerar a
        // seleção no meio da operação assíncrona faz a árvore recomputar os
        // checkboxes a partir de um LoadedFiles intermediário, desmarcando o
        // que o usuário acabou de marcar. O reset é feito só ao abrir algo novo.
        if (Store.IsLoading)
        {
            _isBusy = true;
            StateHasChanged();
        }
        else
        {
            ReportarFalhasDeLeitura();
            AplicarFiltros();
        }
    });

    private void OnGroupsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Um conjunto novo de caminhos foi carregado (menu Abrir, arrastar e soltar, linha de
    /// comando ou outra instância): a seleção de arquivos visíveis não vale mais.
    /// </summary>
    private void OnPathsLoaded() => _visibleFiles = null;

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Store.PathsLoaded -= OnPathsLoaded;
        GroupService.Changed -= OnGroupsChanged;

        foreach (var campo in new[] { Interlocked.Exchange(ref _filterCts, null), Interlocked.Exchange(ref _debounceCts, null) })
        {
            if (campo is null) continue;
            try { campo.Cancel(); } catch (ObjectDisposedException) { }
            campo.Dispose();
        }
    }

    private void CheckDefaultApp()
    {
        try
        {
            if (!FileAssociationService.IsDefaultHandler())
            {
                _showDefaultAppNotification = true;
            }
        }
        catch (Exception ex)
        {
            // Não é acionável pelo usuário: apenas não exibimos o aviso de app padrão.
            AppLog.Warning("Falha ao verificar a associação de arquivos", ex);
        }
    }

    private void SetAsDefaultApp()
    {
        FileAssociationService.SetAsDefault();
        _showDefaultAppNotification = false;
    }

    private void DismissNotification()
    {
        _showDefaultAppNotification = false;
    }

    private void Carregar()
    {
        AplicarFiltros();
    }

    /// <summary>
    /// Dispara a filtragem a partir de contextos síncronos (setters de propriedade e
    /// handlers de evento). Descartar a Task é seguro porque <see cref="AplicarFiltrosAsync"/>
    /// trata as próprias exceções — ao contrário de um <c>async void</c>, cuja exceção
    /// escaparia para o contexto de sincronização e derrubaria a UI.
    /// </summary>
    private void AplicarFiltros() => _ = AplicarFiltrosAsync();

    private async Task AplicarFiltrosAsync()
    {
        // Cada invocação é dona do próprio CTS e o descarta no finally: cancelamos o
        // anterior (sem descartá-lo, pois a invocação dele ainda pode estar lendo o token)
        // e deixamos que aquela invocação faça o próprio descarte ao terminar.
        var cts = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _filterCts, cts);
        if (previous is not null)
        {
            try { previous.Cancel(); } catch (ObjectDisposedException) { }
        }
        var token = cts.Token;

        _isBusy = true;
        StateHasChanged();

        try
        {
            var criterios = new LogFilterCriteria
            {
                VisibleFiles = _visibleFiles,
                QuickLevel = _filtroRapido,
                From = _dataInicial,
                To = _dataFinal,
                Search = _textoPesquisa,
                // O Store mantém os eventos ordenados e os filtros preservam a ordem
                // relativa, então não há por que reordenar tudo a cada filtragem.
                InputAlreadySorted = true,
            };

            await Task.Run(() =>
            {
                if (token.IsCancellationRequested) return;

                // Snapshot sob lock: a filtragem enumera fora do lock do Store,
                // enquanto UpdateLoadedFiles pode mutar a lista em paralelo.
                var result = LogFilter.Apply(Store.Snapshot(), criterios);

                if (token.IsCancellationRequested) return;

                InvokeAsync(() =>
                {
                    _todosEventos = result;
                    if (_pagina > UltimaPagina) _pagina = 1;
                    AtualizarPagina();
                    _isBusy = false;
                    StateHasChanged();
                });

            }, token);
        }
        catch (OperationCanceledException)
        {
            // Filtragem substituída por outra mais recente — descarte esperado.
        }
        catch (Exception ex)
        {
            AppLog.Error("Falha ao aplicar os filtros", ex);
            Notifications.Error("Não foi possível aplicar os filtros", ex.Message);
            _isBusy = false;
            StateHasChanged();
        }
        finally
        {
            // Só limpa o campo se ainda apontar para este CTS (uma invocação mais
            // recente pode tê-lo substituído) e então descarta o próprio.
            Interlocked.CompareExchange(ref _filterCts, null, cts);
            cts.Dispose();
        }
    }

    private void AtualizarPagina()
    {
        var skip = (Pagina - 1) * QuantidadeRegistros;
        _eventos = _todosEventos.Skip(skip).Take(QuantidadeRegistros).ToList();
    }

    private async Task AbrirArquivoDialog()
    {
        var file = await FilePicker.PickFileAsync("Arquivos CLEF (*.clef)|*.clef|Todos os arquivos (*.*)|*.*");
        if (file != null)
        {
            _visibleFiles = null; // novo carregamento: mostra todos os arquivos
            _isBusy = true;
            StateHasChanged();
            await Store.LoadFromFile(file);
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task AbrirPastaDialog()
    {
        var folder = await FilePicker.PickFolderAsync();
        if (folder != null)
        {
            _visibleFiles = null; // novo carregamento: mostra todos os arquivos
            _isBusy = true;
            StateHasChanged();
            await Store.LoadFromFolderAsync(folder);
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task AbrirGrupo(LogGroup group)
    {
        if (group.Paths.Any())
        {
            _visibleFiles = null; // novo carregamento: mostra todos os arquivos
            _isBusy = true;
            StateHasChanged();
            await Store.LoadFromPathsAsync(group.Paths);
            _isBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>Interrompe o carregamento em andamento, preservando o conteúdo anterior.</summary>
    private void CancelarCarregamento()
    {
        Store.CancelLoad();
        Notifications.Info("Carregamento cancelado");
    }

    /// <summary>Liga/desliga o acompanhamento ao vivo dos arquivos carregados.</summary>
    private void AlternarAoVivo()
    {
        var ligando = !Store.TailEnabled;
        Store.SetTailEnabled(ligando);

        Notifications.Info(
            ligando ? "Acompanhamento ao vivo ligado" : "Acompanhamento ao vivo desligado",
            ligando ? "Novos eventos gravados nos arquivos carregados aparecerão automaticamente." : null);
    }

    /// <summary>
    /// Exporta o conjunto FILTRADO inteiro — não apenas a página exibida, que é o que o
    /// usuário vê mas raramente o que quer compartilhar.
    /// </summary>
    private async Task ExportarFiltrados()
    {
        if (_todosEventos.Count == 0) return;

        var sugestao = $"clef-export-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        var destino = await FilePicker.PickSaveFileAsync(LogExporter.DialogFilter, sugestao);
        if (destino is null) return;

        try
        {
            var formato = LogExporter.FormatFromPath(destino);
            var conteudo = await Task.Run(() => LogExporter.Export(_todosEventos, formato));
            await File.WriteAllTextAsync(destino, conteudo);

            Notifications.Success(
                $"{_todosEventos.Count} eventos exportados",
                Path.GetFileName(destino));
        }
        catch (Exception ex)
        {
            AppLog.Error($"Falha ao exportar para '{destino}'", ex);
            Notifications.Error("Não foi possível exportar", ex.Message);
        }
    }

    private async Task AbrirConfiguracoes()
    {
        await Dialog.OpenAsync<SettingsDialog>("Configurações", null, new DialogOptions { Width = "640px" });
    }

    private async Task AbrirGerenciadorGrupos()
    {
        await Dialog.OpenAsync<LogGroupManager>("Gerenciar Grupos de Log", null, new DialogOptions { Width = "820px" });
        StateHasChanged(); // grupos podem ter mudado
    }

    private void Select(ClefEvent e)
    {
        _selected = e;
    }

    private void CloseDetail()
    {
        _selected = null;
    }

    private void FiltrarPorTexto(string texto)
    {
        TextoPesquisa = texto;
    }
}
