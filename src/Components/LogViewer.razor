@using System.Threading
@using System.Text.RegularExpressions
@using ClefExplorer.Models
@using ClefExplorer.Services
@using ClefExplorer.Helpers
@implements IDisposable

@inject LogStore Store
@inject LogGroupService GroupService
@inject IFilePickerService FilePicker
@inject FileAssociationService FileAssociationService
@inject SettingsService SettingsService
@inject DialogService Dialog
@inject NotificationService Notifications
@inject UiPreferencesService UiPreferences
@inject ConsultaLogs Consulta
@inject NavegacaoCorrelacao Navegacao
@inject AnaliseTemporalCorrelacao AnaliseTemporal
@inject ServicoAtualizacao Atualizacao
@inject ExploradorArquivos Explorador
@inject IJSRuntime JS

<div class="clef-root">
    <LogHeader @bind-TextoPesquisa="TextoPesquisa"
               @bind-UsarRegex="UsarRegex"
               RegexInvalida="@RegexInvalida"
               OnReload="Carregar" />

    @if (_showDefaultAppNotification)
    {
        <OmniBanner Severity="NotificationSeverity.Warning" Dismissible="true" OnClosed="DismissNotification">
            <ChildContent>
                O Clef Explorer não é o aplicativo padrão para arquivos de log (.clef).
            </ChildContent>
            <Actions>
                <OmniButton Text="Definir como padrão" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="SetAsDefaultApp" />
            </Actions>
        </OmniBanner>
    }

    @if (_atualizacao is { } atualizacao && !_avisoAtualizacaoDispensado)
    {
        <OmniBanner Severity="NotificationSeverity.Info" Dismissible="true" OnClosed="DispensarAvisoAtualizacao">
            <ChildContent>
                A versão @atualizacao.Versao do Clef Explorer está disponível.
                @if (atualizacao.PodeReiniciar)
                {
                    <text> Ela já foi baixada e será aplicada ao reiniciar.</text>
                }
            </ChildContent>
            <Actions>
                @if (atualizacao.PodeReiniciar)
                {
                    <OmniButton Text="Reiniciar agora" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="AplicarAtualizacao" />
                }
                else
                {
                    <OmniButton Text="Ver no GitHub" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="AbrirPaginaDaAtualizacao" />
                }
            </Actions>
        </OmniBanner>
    }

    <div class="clef-body">
        <OmniSplitter Orientation="Orientation.Horizontal" Variant="SplitterVariant.Line">
            <OmniSplitterPane Size="260px" Min="200px" Max="600px">
                <div class="clef-pane">
                    <LogSidebar @bind-NiveisSelecionados="NiveisSelecionados"
                                @bind-VisibleFiles="VisibleFiles"
                                @bind-DataInicial="DataInicial"
                                @bind-DataFinal="DataFinal"
                                LoadedFiles="@Store.LoadedFiles"
                                AvailableFiles="@Store.AvailableFiles"
                                LogGroups="@GroupService.Groups"
                                OnOpenFile="AbrirArquivoDialog"
                                OnOpenFolder="AbrirPastaDialog"
                                OnOpenGroup="AbrirGrupo"
                                OnManageGroups="AbrirGerenciadorGrupos"
                                OnOpenSettings="AbrirConfiguracoes" />
                </div>
            </OmniSplitterPane>

            <OmniSplitterPane>
                <div class="clef-main">
                    <LogToolbar Subtitulo="@Subtitulo"
                                TotalCount="@_todosEventos.Count"
                                 OnExport="ExportarFiltrados"
                                 IsExporting="@_isExporting"
                                 ExportProgressText="@TextoProgressoExportacao"
                                 ExportProcessados="@_eventosExportados"
                                 ExportTotal="@_totalExportacao"
                                 OnCancelExport="CancelarExportacao"
                                TailEnabled="@Store.TailEnabled"
                                OnToggleTail="AlternarAoVivo"
                                 IsLoading="@Store.IsLoading"
                                 LoadProgressText="@Store.LoadProgressText"
                                 ProgressoCarga="@ProgressoCarga"
                                OnCancelLoad="CancelarCarregamento"
                                IsFiltering="@_consultaDemorada"
                                OnCancelFilter="CancelarFiltragem"
                                DetailVisible="@(_selected != null)"
                                DetailAtBottom="@DetalheAbaixo"
                                OnToggleDetailPosition="AlternarPosicaoDetalhe"
                                ViewMode="@UiPreferences.Preferences.ViewMode"
                                OnSetViewMode="DefinirModoVisualizacao" />

                    <div class="clef-body">
                        @* Sem seleção: o miolo ocupa todo o espaço, SEM splitter. Manter o
                           splitter sempre montado (com o pane do detalhe colapsado) foi
                           tentado e reintroduz a race de medição: o splitter aninhado mede
                           0px e o conteúdo some.

                           O @key na orientação: o splitter mede e fixa os tamanhos dos panes
                           na inicialização, então reaproveitar a instância deixaria as
                           medidas da disposição anterior aplicadas na nova. *@
                        @if (_selected != null)
                        {
                            <OmniSplitter @key="DetalheAbaixo"
                                          Orientation="@(DetalheAbaixo ? Orientation.Vertical : Orientation.Horizontal)"
                                          Variant="SplitterVariant.Line">
                                <OmniSplitterPane Min="@(DetalheAbaixo ? "120px" : "320px")">
                                    <div class="clef-pane">
                                        @RenderEventos()
                                    </div>
                                </OmniSplitterPane>
                                <OmniSplitterPane Size="45%" Min="@(DetalheAbaixo ? "140px" : "320px")">
                                    <div class="clef-pane">
                                        @if (_resultadoCorrelacao is not null)
                                        {
                                            @* À direita, empilhamos correlação sobre detalhes para não
                                               espremer dois painéis estreitos. Com o detalhe abaixo da
                                               lista há largura disponível, então eles ficam lado a lado. *@
                                            <OmniSplitter @key="_resultadoCorrelacao"
                                                          Orientation="@(DetalheAbaixo ? Orientation.Horizontal : Orientation.Vertical)"
                                                          Variant="SplitterVariant.Line">
                                                <OmniSplitterPane Size="@(DetalheAbaixo ? "40%" : "50%")"
                                                                  Min="@(DetalheAbaixo ? "300px" : "220px")">
                                                    <div class="clef-pane">
                                                        <LogCorrelationNavigator Resultado="@_resultadoCorrelacao"
                                                                                 AnaliseTemporal="@(_analiseTemporalCorrelacao!)"
                                                                                 SelectedEvent="@_selected"
                                                                                 OnSelect="SelecionarDaCorrelacao"
                                                                                 OnClose="FecharNavegacaoCorrelacao" />
                                                    </div>
                                                </OmniSplitterPane>
                                                <OmniSplitterPane Min="@(DetalheAbaixo ? "320px" : "200px")">
                                                    <div class="clef-pane">
                                                        @RenderDetalhes()
                                                    </div>
                                                </OmniSplitterPane>
                                            </OmniSplitter>
                                        }
                                        else
                                        {
                                            @RenderDetalhes()
                                        }
                                    </div>
                                </OmniSplitterPane>
                            </OmniSplitter>
                        }
                        else
                        {
                            <div class="clef-pane">
                                @RenderEventos()
                            </div>
                        }
                    </div>
                </div>
            </OmniSplitterPane>
        </OmniSplitter>
    </div>
</div>

@* Lista ou tabela conforme a preferência — o resto do layout (splitter, detalhe) é o
   mesmo nos dois modos, então só o miolo troca. *@
@code {
    private RenderFragment RenderDetalhes() => __builder =>
    {
        <LogDetails SelectedEvent="@_selected"
                    OnClose="CloseDetail"
                    OnFilter="FiltrarPorTexto"
                    CanNavigateCorrelation="@Navegacao.PodeNavegar(_selected)"
                    IsLocatingCorrelation="@_buscandoCorrelacao"
                    OnNavigateCorrelation="AbrirNavegacaoCorrelacao" />
    };

    private RenderFragment RenderEventos() => __builder =>
    {
        @* Carregando e ainda sem nada para mostrar: o miolo inteiro vira o indicador de
           progresso. Um texto pequeno na barra superior, com a área central vazia, lia-se
           como "não tem log" ou "travou" — que é o oposto de "estou lendo 40 arquivos". *@
        if (EstaCarregandoVazio)
        {
            <div class="clef-center clef-loading">
                <OmniSpinner Size="ComponentSize.Lg" />
                <div class="clef-loading-title">Carregando logs…</div>
                @if (ProgressoCarga is { } fracao)
                {
                    <OmniProgress Value="@(fracao * 100)" Class="clef-loading-progress" />
                }
                <div class="clef-loading-detail" role="status" aria-live="polite">
                    @(string.IsNullOrWhiteSpace(Store.LoadProgressText) ? "Preparando a leitura…" : Store.LoadProgressText)
                </div>
                @* Contagem parcial: enquanto o Store publicar os eventos só no fim da
                   leitura ela fica em zero e some — quando ele passar a publicar em lotes,
                   o número aparece sozinho e a tela deixa de ser só um spinner. *@
                @if (Store.Count > 0)
                {
                    <div class="clef-loading-detail">@Store.Count.ToString("N0") eventos lidos até agora</div>
                }
                <div class="clef-loading-hint">Arquivos grandes levam alguns segundos. Você pode interromper a qualquer momento.</div>
                <OmniButton Text="Cancelar carregamento" Icon="x" Size="ComponentSize.Sm"
                            Variant="ButtonVariant.Ghost" OnClick="CancelarCarregamento" />
            </div>
        }
        else if (ModoEstatisticas)
        {
            @* O painel de estatísticas não recebe IsBusy (é de outra frente): trocar o
               painel inteiro pelo spinner dá o mesmo resultado e evita exibir os números
               de um filtro que já não vale. *@
            if (_isBusy)
            {
                <div class="clef-center">
                    <OmniSpinner Size="ComponentSize.Lg" />
                    <span>Calculando estatísticas...</span>
                </div>
            }
            else
            {
                <LogStatsPanel Stats="@_stats"
                               OnFilterLevel="FiltrarPorNivel"
                               OnFilterText="FiltrarPorTexto" />
            }
        }
        @* Lista e tabela recebem o conjunto FILTRADO INTEIRO, e não uma página.
           Entregar 50 itens fazia o grid ordenar, agrupar e filtrar só dentro deles: o
           usuário clicava em "Data/hora" e reordenava a página, não o log. Os dois
           componentes virtualizam (só o que está na tela vai ao DOM), então a rolagem
           substitui a paginação sem custo de renderização. *@
        else if (ModoTabela)
        {
            <LogGrid IsBusy="@_isBusy"
                     Eventos="@_todosEventos"
                     SelectedEvent="@_selected"
                     CorrelatedEvents="@_eventosCorrelacionados"
                     OnSelect="Select"
                     Colunas="@_colunasDescobertas"
                     VisibleColumns="@ColunasVisiveis"
                     VisibleColumnsChanged="SalvarColunasVisiveis" />
        }
        else
        {
            <LogList IsBusy="@_isBusy"
                     Eventos="@_todosEventos"
                     SelectedEvent="@_selected"
                     CorrelatedEvents="@_eventosCorrelacionados"
                     OnSelect="Select" />
        }
    };

    /// <summary>
    /// Carga em andamento sem nada ainda na tela. Enquanto já houver eventos exibidos, o
    /// progresso fica só na barra: trocar a lista por um spinner tiraria do usuário o que
    /// ele já conseguia ler.
    /// </summary>
    private bool EstaCarregandoVazio => Store.IsLoading && _todosEventos.Count == 0;

    private ClefEvent? _selected;
    private ResultadoNavegacaoCorrelacao? _resultadoCorrelacao;
    private ResultadoAnaliseTemporalCorrelacao? _analiseTemporalCorrelacao;
    private HashSet<ClefEvent> _eventosCorrelacionados = new();
    private bool _buscandoCorrelacao;
    private CancellationTokenSource? _correlationCts;
    private bool _isBusy;
    private bool _descartado;

    /// <summary>
    /// Consultas de filtragem ainda em voo. O <c>_isBusy</c> ficava PRESO em true sempre
    /// que <c>ExecutarAsync</c> devolvia null (consulta substituída por outra mais
    /// recente): esse caminho saía por <c>return</c> sem desligar o indicador, e bastava
    /// uma filtragem durar mais que o intervalo do modo ao vivo para o spinner ficar na
    /// tela para sempre. Contando as consultas — todas passam pelo <c>finally</c>,
    /// inclusive as descartadas — o indicador fica amarrado ao ciclo de vida delas.
    /// Só é tocado no dispatcher: todo ponto de entrada da filtragem já está nele, e os
    /// <c>await</c> de um componente Blazor retomam nele.
    /// </summary>
    private int _consultasEmVoo;

    /// <summary>
    /// Uma filtragem passou do limiar sem terminar. Abaixo dele o aviso entraria e sairia
    /// da tela a cada tecla da busca, sem dar tempo de ser lido.
    /// </summary>
    private bool _consultaDemorada;

    private static readonly TimeSpan LimiarDeDemora = TimeSpan.FromMilliseconds(300);

    private List<ClefEvent> _todosEventos = new();
    private string _textoPesquisa = string.Empty;
    private HashSet<string> _niveisSelecionados = new(StringComparer.OrdinalIgnoreCase);
    private bool _usarRegex;
    private HashSet<string>? _visibleFiles;
    private DateTime? _dataInicial;
    private DateTime? _dataFinal;
    private bool _showDefaultAppNotification;
    private InfoAtualizacao? _atualizacao;
    private bool _avisoAtualizacaoDispensado;
    private bool _isExporting;
    private int _eventosExportados;
    private int _totalExportacao;
    private CancellationTokenSource? _exportCts;

    private string TextoProgressoExportacao =>
        $"Exportando {_eventosExportados:N0}/{_totalExportacao:N0}";

    /// <summary>
    /// Fração concluída da carga, ou <c>null</c> enquanto não houver como medi-la.
    /// O único percentual honesto é o de BYTES lidos (a soma dos tamanhos dos arquivos
    /// como denominador); "X/Y arquivos", que é o que o LogStore publica hoje, marca 95%
    /// com o .clef de 150 MB ainda por ler. Ligar isto depende de o Store expor os bytes
    /// lidos e o total a ler — enquanto não expõe, a barra não aparece e fica só o texto.
    /// </summary>
    private double? ProgressoCarga => null;

    /// <summary>
    /// Quantos eventos o filtro selecionou, e quantos existem carregados. A rolagem
    /// virtualizada substituiu a paginação — o que interessa agora é o tamanho do
    /// conjunto, não em que fatia dele o usuário está.
    /// </summary>
    private string Subtitulo
    {
        get
        {
            var total = Store.Count;
            var filtrados = _todosEventos.Count;
            if (total == 0) return "Nenhum log carregado";
            return filtrados == total
                ? $"{total:N0} eventos"
                : $"{filtrados:N0} de {total:N0} eventos";
        }
    }

    private string TextoPesquisa
    {
        get => _textoPesquisa;
        set
        {
            _textoPesquisa = value;
            // Debounce: sem ele, cada tecla varria todos os eventos. A filtragem anterior
            // até era cancelada, mas o agendamento e a re-renderização continuavam custando.
            AgendarFiltragem();
        }
    }

    private CancellationTokenSource? _debounceCts;
    private static readonly TimeSpan DebounceBusca = TimeSpan.FromMilliseconds(250);

    private void AgendarFiltragem()
    {
        var cts = new CancellationTokenSource();
        var anterior = Interlocked.Exchange(ref _debounceCts, cts);
        if (anterior is not null)
        {
            try { anterior.Cancel(); } catch (ObjectDisposedException) { }
            anterior.Dispose();
        }

        _ = EsperarEFiltrar(cts);
    }

    private async Task EsperarEFiltrar(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DebounceBusca, cts.Token);
            await AplicarFiltrosAsync();
        }
        catch (OperationCanceledException)
        {
            // Outra tecla chegou antes do prazo: esta filtragem foi descartada.
        }
        finally
        {
            Interlocked.CompareExchange(ref _debounceCts, null, cts);
            cts.Dispose();
        }
    }

    private bool UsarRegex
    {
        get => _usarRegex;
        set
        {
            _usarRegex = value;
            AplicarFiltros();
        }
    }

    /// <summary>Padrão digitado ainda não compila — o botão de regex sinaliza isso.</summary>
    private bool RegexInvalida => _usarRegex && !LogFilter.IsValidRegex(_textoPesquisa);

    private HashSet<string> NiveisSelecionados
    {
        get => _niveisSelecionados;
        set
        {
            _niveisSelecionados = value;
            AplicarFiltros();
        }
    }

    private HashSet<string>? VisibleFiles
    {
        get => _visibleFiles;
        set
        {
            if (_visibleFiles != value)
            {
                _visibleFiles = value;
                if (_visibleFiles != null)
                {
                    _ = Store.UpdateLoadedFiles(_visibleFiles);
                }
                AplicarFiltros();
            }
        }
    }

    private DateTime? DataInicial
    {
        get => _dataInicial;
        set
        {
            if (_dataInicial != value)
            {
                _dataInicial = value;
                AplicarFiltros();
            }
        }
    }

    private DateTime? DataFinal
    {
        get => _dataFinal;
        set
        {
            if (_dataFinal != value)
            {
                _dataFinal = value;
                AplicarFiltros();
            }
        }
    }

    protected override void OnInitialized()
    {
        // Handlers nomeados (não lambdas) para poderem ser desinscritos no Dispose:
        // LogStore e LogGroupService são singletons, então um handler não removido
        // mantém este componente vivo enquanto o app existir.
        Store.Changed += OnStoreChanged;
        Store.PathsLoaded += OnPathsLoaded;
        GroupService.Changed += OnGroupsChanged;

        if (Store.IsLoading)
        {
            _isBusy = true;
        }
        else if (Store.Count > 0)
        {
            AplicarFiltros();
        }

        Atualizacao.Changed += OnAtualizacaoEncontrada;
        // Uma verificação que já tenha terminado antes deste componente existir (o serviço
        // é singleton e sobrevive a recargas da UI) não dispara o evento de novo.
        _atualizacao = Atualizacao.Disponivel;

        CheckDefaultApp();
        ReportarErrosDeInicializacao();
    }

    /// <summary>
    /// Os serviços de configuração são construídos pela DI antes de existir UI, então um
    /// arquivo inválido ou uma pasta sem permissão só pode ser reportado aqui. Antes esses
    /// erros eram engolidos e o usuário via a configuração simplesmente "sumir".
    /// </summary>
    private void ReportarErrosDeInicializacao()
    {
        if (SettingsService.LastError is { } erroConfig)
        {
            Notifications.Error("Configurações", erroConfig);
        }

        if (GroupService.LastError is { } erroGrupos)
        {
            Notifications.Error("Grupos de log", erroGrupos);
        }
    }

    /// <summary>Avisa sobre arquivos que não puderam ser lidos no último carregamento.</summary>
    private void ReportarFalhasDeLeitura()
    {
        var falhas = Store.LoadFailures;
        if (falhas.Count == 0) return;

        var resumo = falhas.Count == 1
            ? "1 arquivo não pôde ser lido"
            : $"{falhas.Count} arquivos não puderam ser lidos";

        // Detalhar até 3 para a mensagem não virar uma parede de texto; o restante
        // fica no log de diagnóstico do app.
        var detalhe = string.Join("\n", falhas.Take(3).Select(f => $"{Path.GetFileName(f.Path)}: {f.Reason}"));
        if (falhas.Count > 3)
        {
            detalhe += $"\n(e mais {falhas.Count - 3}; veja {AppLog.FilePath})";
        }

        Notifications.Warning(resumo, detalhe);
    }

    private void OnStoreChanged() => DespacharNaUi(() =>
    {
        // NÃO resetar _visibleFiles aqui: este evento também dispara durante
        // UpdateLoadedFiles (ao (des)marcar arquivos na árvore), e zerar a
        // seleção no meio da operação assíncrona faz a árvore recomputar os
        // checkboxes a partir de um LoadedFiles intermediário, desmarcando o
        // que o usuário acabou de marcar. O reset é feito só ao abrir algo novo.
        if (Store.IsLoading)
        {
            // Mesma regra da filtragem: com eventos já na tela, o progresso fica só na
            // barra superior em vez de substituir o que o usuário estava lendo.
            if (_todosEventos.Count == 0) _isBusy = true;
            StateHasChanged();
        }
        else
        {
            ReportarFalhasDeLeitura();
            AplicarFiltros();
        }
    });

    private void OnGroupsChanged() => DespacharNaUi(StateHasChanged);

    /// <summary>
    /// Um conjunto novo de caminhos foi carregado (menu Abrir, arrastar e soltar, linha de
    /// comando ou outra instância): a seleção de arquivos visíveis não vale mais.
    /// </summary>
    /// <remarks>
    /// O LogStore dispara este evento de uma thread do pool (os await de
    /// LoadFromPathsAsync usam ConfigureAwait(false)), então escrever <c>_visibleFiles</c>
    /// direto corria com a leitura do campo na thread da UI — inclusive durante o render.
    /// </remarks>
    private void OnPathsLoaded() => DespacharNaUi(() => _visibleFiles = null);

    /// <summary>
    /// Executa no dispatcher e NÃO engole a exceção. Com <c>_ = InvokeAsync(...)</c> a
    /// Task descartada guardava qualquer falha do callback (ReportarFalhasDeLeitura, por
    /// exemplo) e ninguém a observava: o evento simplesmente não acontecia, sem rastro.
    /// </summary>
    private void DespacharNaUi(Action acao) => _ = DespacharNaUiAsync(acao);

    private async Task DespacharNaUiAsync(Action acao)
    {
        try
        {
            await InvokeAsync(acao);
        }
        catch (ObjectDisposedException)
        {
            // Componente descartado enquanto o evento do Store estava a caminho.
        }
        catch (Exception ex)
        {
            AppLog.Error("Falha ao processar um evento do LogStore", ex);
        }
    }

    // --- Atalhos de teclado ------------------------------------------------------

    private DotNetObjectReference<LogViewer>? _shortcutRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _shortcutRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("clefShortcuts.register", _shortcutRef);
        }
        catch (Exception ex)
        {
            // Sem atalhos o app segue utilizável pelo mouse.
            AppLog.Warning("Não foi possível registrar os atalhos de teclado", ex);
        }

        try
        {
            await JS.InvokeVoidAsync("clefInternalDrag.register", _shortcutRef);
        }
        catch (Exception ex)
        {
            // Sem isto, arrastar dentro da página (agrupar por coluna) segue bloqueado,
            // mas o resto do app não é afetado.
            AppLog.Warning("Não foi possível registrar o arraste interno", ex);
        }

        // Depois do primeiro render, sem await: a janela já está na tela e a faixa aparece
        // quando (e se) a resposta chegar. O serviço trata as próprias exceções.
        _ = Atualizacao.VerificarAsync();
    }

    /// <summary>
    /// Avisa o host que um arraste DENTRO da página começou (ou terminou), para ele
    /// liberar o WebView2 como alvo de soltura enquanto durar. Ver wwwroot/js/internal-drag.js.
    /// </summary>
    [JSInvokable]
    public void SetInternalDragMode(bool interno) => WebViewDropMode.SetInternalDrag(interno);

    /// <summary>Recebe as ações traduzidas pelo listener de teclado (wwwroot/js/shortcuts.js).</summary>
    [JSInvokable]
    public async Task OnShortcut(string action)
    {
        switch (action)
        {
            case "open-file": await AbrirArquivoDialog(); break;
            case "open-folder": await AbrirPastaDialog(); break;
            case "export": await ExportarFiltrados(); break;
            case "toggle-tail": AlternarAoVivo(); break;
            case "reload": Carregar(); break;
            case "next": MoverSelecao(1); break;
            case "previous": MoverSelecao(-1); break;
            default: return;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Posição de <see cref="_selected"/> em <see cref="_todosEventos"/>, ou -1 quando não
    /// se sabe. Cada seta fazia um IndexOf linear no conjunto inteiro — 5,1 ms com 1 milhão
    /// de eventos, e com o auto-repeat do teclado (~30 teclas/s) isso ocupava a thread da
    /// UI o tempo todo. Guardando a posição, só a PRIMEIRA seta depois de um clique ou de
    /// uma filtragem paga a varredura.
    /// </summary>
    private int _indiceSelecionado = -1;

    private int IndiceDaSelecao()
    {
        if (_selected is null) return -1;

        // O índice guardado só vale enquanto ainda apontar para o evento selecionado: a
        // lista é substituída a cada filtragem e a seleção sobrevive a ela.
        if (_indiceSelecionado >= 0
            && _indiceSelecionado < _todosEventos.Count
            && ReferenceEquals(_todosEventos[_indiceSelecionado], _selected))
        {
            return _indiceSelecionado;
        }

        return _indiceSelecionado = _todosEventos.IndexOf(_selected);
    }

    /// <summary>Move a seleção pelo conjunto filtrado (setas ↑/↓).</summary>
    private void MoverSelecao(int delta)
    {
        if (_todosEventos.Count == 0) return;

        var atual = IndiceDaSelecao();
        // Sem seleção: ↓ começa no primeiro, ↑ no último.
        var proximo = atual < 0
            ? (delta > 0 ? 0 : _todosEventos.Count - 1)
            : Math.Clamp(atual + delta, 0, _todosEventos.Count - 1);

        _selected = _todosEventos[proximo];
        _indiceSelecionado = proximo;
    }

    public void Dispose()
    {
        // Continuações em voo (filtragem, estatísticas, aviso de demora) ainda podem
        // retomar depois daqui; a partir deste ponto elas não tocam mais no componente.
        _descartado = true;

        _ = JS.InvokeVoidAsync("clefShortcuts.unregister");
        _ = JS.InvokeVoidAsync("clefInternalDrag.unregister");
        WebViewDropMode.SetInternalDrag(false);
        _shortcutRef?.Dispose();

        Store.Changed -= OnStoreChanged;
        Store.PathsLoaded -= OnPathsLoaded;
        GroupService.Changed -= OnGroupsChanged;
        Atualizacao.Changed -= OnAtualizacaoEncontrada;

        Consulta.CancelarConsultaAtual();
        foreach (var campo in new[]
        {
            Interlocked.Exchange(ref _debounceCts, null),
            Interlocked.Exchange(ref _exportCts, null),
            Interlocked.Exchange(ref _correlationCts, null),
        })
        {
            if (campo is null) continue;
            try { campo.Cancel(); } catch (ObjectDisposedException) { }
            campo.Dispose();
        }
    }

