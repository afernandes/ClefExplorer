@using System.Threading
@using System.Text.RegularExpressions
@using ClefExplorer.Models
@using ClefExplorer.Services
@using ClefExplorer.Helpers
@implements IDisposable

@inject LogStore Store
@inject LogGroupService GroupService
@inject IFilePickerService FilePicker
@inject FileAssociationService FileAssociationService
@inject SettingsService SettingsService
@inject DialogService Dialog
@inject NotificationService Notifications
@inject UiPreferencesService UiPreferences
@inject ConsultaLogs Consulta
@inject NavegacaoCorrelacao Navegacao
@inject AnaliseTemporalCorrelacao AnaliseTemporal
@inject ServicoAtualizacao Atualizacao
@inject ExploradorArquivos Explorador
@inject IJSRuntime JS

@{
    RenderFragment detalhes = @<text>
        <LogDetails SelectedEvent="@_selected"
                    OnClose="CloseDetail"
                    OnFilter="FiltrarPorTexto"
                    CanNavigateCorrelation="@Navegacao.PodeNavegar(_selected)"
                    IsLocatingCorrelation="@_buscandoCorrelacao"
                    OnNavigateCorrelation="AbrirNavegacaoCorrelacao" />
    </text>;
    RenderFragment eventos = @<text>
        @* Carregando e ainda sem nada para mostrar: o miolo inteiro vira o indicador de
           progresso. Um texto pequeno na barra superior, com a área central vazia, lia-se
           como "não tem log" ou "travou" — que é o oposto de "estou lendo 40 arquivos". *@
        @if (EstaCarregandoVazio)
        {
            <div class="clef-center clef-loading">
                <OmniSpinner Size="ComponentSize.Lg" />
                <div class="clef-loading-title">Carregando logs…</div>
                @if (ProgressoCarga is { } fracao)
                {
                    <OmniProgress Value="@(fracao * 100)" Class="clef-loading-progress" />
                }
                <div class="clef-loading-detail" role="status" aria-live="polite">
                    @(string.IsNullOrWhiteSpace(Store.LoadProgressText) ? "Preparando a leitura…" : Store.LoadProgressText)
                </div>
                @* Contagem parcial: enquanto o Store publicar os eventos só no fim da
                   leitura ela fica em zero e some — quando ele passar a publicar em lotes,
                   o número aparece sozinho e a tela deixa de ser só um spinner. *@
                @if (Store.Count > 0)
                {
                    <div class="clef-loading-detail">@Store.Count.ToString("N0") eventos lidos até agora</div>
                }
                <div class="clef-loading-hint">Arquivos grandes levam alguns segundos. Você pode interromper a qualquer momento.</div>
                <OmniButton Text="Cancelar carregamento" Icon="x" Size="ComponentSize.Sm"
                            Variant="ButtonVariant.Ghost" OnClick="CancelarCarregamento" />
            </div>
        }
        else if (ModoEstatisticas)
        {
            @* O painel de estatísticas não recebe IsBusy (é de outra frente): trocar o
               painel inteiro pelo spinner dá o mesmo resultado e evita exibir os números
               de um filtro que já não vale. *@
            if (_isBusy)
            {
                <div class="clef-center">
                    <OmniSpinner Size="ComponentSize.Lg" />
                    <span>Calculando estatísticas...</span>
                </div>
            }
            else
            {
                <LogStatsPanel Stats="@_stats"
                               OnFilterLevel="FiltrarPorNivel"
                               OnFilterRanking="FiltrarPorRanking" />
            }
        }
        @* Lista e tabela recebem o conjunto FILTRADO INTEIRO, e não uma página.
           Entregar 50 itens fazia o grid ordenar, agrupar e filtrar só dentro deles: o
           usuário clicava em "Data/hora" e reordenava a página, não o log. Os dois
           componentes virtualizam (só o que está na tela vai ao DOM), então a rolagem
           substitui a paginação sem custo de renderização. *@
        else if (ModoTabela)
        {
            <LogGrid IsBusy="@_isBusy"
                     Eventos="@_todosEventos"
                     SelectedEvent="@_selected"
                     CorrelatedEvents="@_eventosCorrelacionados"
                     OnSelect="Select"
                     Colunas="@_colunasDescobertas"
                     VisibleColumns="@ColunasVisiveis"
                     VisibleColumnsChanged="SalvarColunasVisiveis" />
        }
        else
        {
            <LogList IsBusy="@_isBusy"
                     Eventos="@_todosEventos"
                     SelectedEvent="@_selected"
                     CorrelatedEvents="@_eventosCorrelacionados"
                     OnSelect="Select" />
        }
    </text>;
}

<div class="clef-root">
    <LogHeader @bind-TextoPesquisa="TextoPesquisa"
               @bind-UsarRegex="UsarRegex"
               RegexInvalida="@RegexInvalida"
               OnReload="Carregar" />

    @if (_showDefaultAppNotification)
    {
        <OmniBanner Severity="NotificationSeverity.Warning" Dismissible="true" OnClosed="DismissNotification">
            <ChildContent>
                O Clef Explorer não é o aplicativo padrão para arquivos de log (.clef).
            </ChildContent>
            <Actions>
                <OmniButton Text="Definir como padrão" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="SetAsDefaultApp" />
            </Actions>
        </OmniBanner>
    }

    @if (_atualizacao is { } atualizacao && !_avisoAtualizacaoDispensado)
    {
        <OmniBanner Severity="NotificationSeverity.Info" Dismissible="true" OnClosed="DispensarAvisoAtualizacao">
            <ChildContent>
                A versão @atualizacao.Versao do Clef Explorer está disponível.
                @if (atualizacao.PodeReiniciar)
                {
                    <text> Ela já foi baixada e será aplicada ao reiniciar.</text>
                }
            </ChildContent>
            <Actions>
                @if (atualizacao.PodeReiniciar)
                {
                    <OmniButton Text="Reiniciar agora" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="AplicarAtualizacao" />
                }
                else
                {
                    <OmniButton Text="Ver no GitHub" Size="ComponentSize.Sm" Variant="ButtonVariant.Primary" OnClick="AbrirPaginaDaAtualizacao" />
                }
            </Actions>
        </OmniBanner>
    }

    <div class="clef-body">
        <OmniSplitter Orientation="Orientation.Horizontal" Variant="SplitterVariant.Line">
            <OmniSplitterPane Size="260px" Min="200px" Max="600px">
                <div class="clef-pane">
                    <LogSidebar @bind-NiveisSelecionados="NiveisSelecionados"
                                @bind-VisibleFiles="VisibleFiles"
                                @bind-DataInicial="DataInicial"
                                @bind-DataFinal="DataFinal"
                                LoadedFiles="@Store.LoadedFiles"
                                AvailableFiles="@Store.AvailableFiles"
                                LogGroups="@GroupService.Groups"
                                OnOpenFile="AbrirArquivoDialog"
                                OnOpenFolder="AbrirPastaDialog"
                                OnOpenGroup="AbrirGrupo"
                                OnManageGroups="AbrirGerenciadorGrupos"
                                OnOpenSettings="AbrirConfiguracoes" />
                </div>
            </OmniSplitterPane>

            <OmniSplitterPane>
                <div class="clef-main">
                    <LogColumnFilters Colunas="_colunasDescobertas" Filtros="_filtrosColuna" FiltrosChanged="AlterarFiltrosColuna" />
                    @if (_filtroRanking is { } ranking)
                    {
                        <div class="clef-active-filter">
                            <span>Filtro do ranking: @ranking.Chave</span>
                            <OmniButton Text="Remover filtro" Icon="x" Size="ComponentSize.Sm" Variant="ButtonVariant.Ghost" OnClick="LimparFiltroRanking" />
                        </div>
                    }
                    <LogToolbar Subtitulo="@Subtitulo"
                                TotalCount="@_todosEventos.Count"
                                 OnExport="ExportarFiltrados"
                                 IsExporting="@_isExporting"
                                 ExportProgressText="@TextoProgressoExportacao"
                                 ExportProcessados="@_eventosExportados"
                                 ExportTotal="@_totalExportacao"
                                 OnCancelExport="CancelarExportacao"
                                TailEnabled="@Store.TailEnabled"
                                OnToggleTail="AlternarAoVivo"
                                 IsLoading="@Store.IsLoading"
                                 LoadProgressText="@Store.LoadProgressText"
                                 ProgressoCarga="@ProgressoCarga"
                                OnCancelLoad="CancelarCarregamento"
                                IsFiltering="@_consultaDemorada"
                                OnCancelFilter="CancelarFiltragem"
                                DetailVisible="@(_selected != null)"
                                DetailAtBottom="@DetalheAbaixo"
                                OnToggleDetailPosition="AlternarPosicaoDetalhe"
                                ViewMode="@UiPreferences.Preferences.ViewMode"
                                OnSetViewMode="DefinirModoVisualizacao" />

                    <div class="clef-body">
                        @* Sem seleção: o miolo ocupa todo o espaço, SEM splitter. Manter o
                           splitter sempre montado (com o pane do detalhe colapsado) foi
                           tentado e reintroduz a race de medição: o splitter aninhado mede
                           0px e o conteúdo some.

                           O @key na orientação: o splitter mede e fixa os tamanhos dos panes
                           na inicialização, então reaproveitar a instância deixaria as
                           medidas da disposição anterior aplicadas na nova. *@
                        @if (_selected != null)
                        {
                            <OmniSplitter @key="DetalheAbaixo"
                                          Orientation="@(DetalheAbaixo ? Orientation.Vertical : Orientation.Horizontal)"
                                          Variant="SplitterVariant.Line">
                                <OmniSplitterPane Min="@(DetalheAbaixo ? "120px" : "320px")">
                                    <div class="clef-pane">
                                        @eventos
                                    </div>
                                </OmniSplitterPane>
                                <OmniSplitterPane Size="45%" Min="@(DetalheAbaixo ? "140px" : "320px")">
                                    <div class="clef-pane">
                                        @if (_resultadoCorrelacao is not null)
                                        {
                                            @* À direita, empilhamos correlação sobre detalhes para não
                                               espremer dois painéis estreitos. Com o detalhe abaixo da
                                               lista há largura disponível, então eles ficam lado a lado. *@
                                            <OmniSplitter @key="_resultadoCorrelacao"
                                                          Orientation="@(DetalheAbaixo ? Orientation.Horizontal : Orientation.Vertical)"
                                                          Variant="SplitterVariant.Line">
                                                <OmniSplitterPane Size="@(DetalheAbaixo ? "40%" : "50%")"
                                                                  Min="@(DetalheAbaixo ? "300px" : "220px")">
                                                    <div class="clef-pane">
                                                        <LogCorrelationNavigator Resultado="@_resultadoCorrelacao"
                                                                                 AnaliseTemporal="@(_analiseTemporalCorrelacao!)"
                                                                                 SelectedEvent="@_selected"
                                                                                 OnSelect="SelecionarDaCorrelacao"
                                                                                 OnClose="FecharNavegacaoCorrelacao" />
                                                    </div>
                                                </OmniSplitterPane>
                                                <OmniSplitterPane Min="@(DetalheAbaixo ? "320px" : "200px")">
                                                    <div class="clef-pane">
                                                        @detalhes
                                                    </div>
                                                </OmniSplitterPane>
                                            </OmniSplitter>
                                        }
                                        else
                                        {
                                            @detalhes
                                        }
                                    </div>
                                </OmniSplitterPane>
                            </OmniSplitter>
                        }
                        else
                        {
                            <div class="clef-pane">
                                @eventos
                            </div>
                        }
                    </div>
                </div>
            </OmniSplitterPane>
        </OmniSplitter>
    </div>
</div>

@* Lista ou tabela conforme a preferência — o resto do layout (splitter, detalhe) é o
   mesmo nos dois modos, então só o miolo troca. *@
