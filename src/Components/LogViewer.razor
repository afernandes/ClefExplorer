    /// <summary>
    /// Exporta o conjunto FILTRADO inteiro — não apenas a página exibida, que é o que o
    /// usuário vê mas raramente o que quer compartilhar.
    /// </summary>
    private async Task ExportarFiltrados()
    {
        if (_todosEventos.Count == 0 || _isExporting) return;

        // Snapshot antes do diálogo: a filtragem e o modo ao vivo substituem _todosEventos
        // de forma assíncrona, então exportar direto do campo poderia gravar um conjunto
        // diferente do que foi contado na mensagem de sucesso.
        var paraExportar = _todosEventos.ToArray();

        var sugestao = $"clef-export-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        var destino = await FilePicker.PickSaveFileAsync(LogExporter.DialogFilter, sugestao);
        if (destino is null) return;

        var cts = new CancellationTokenSource();
        _exportCts = cts;
        _isExporting = true;
        _eventosExportados = 0;
        _totalExportacao = paraExportar.Length;
        StateHasChanged();

        try
        {
            var formato = LogExporter.FormatFromPath(destino);
            // O LogExporter já limita o ritmo (1% do total ou 250 ms): são ~100 avisos por
            // exportação, e não um por evento como antes — o que enfileirava 200 mil
            // StateHasChanged e sozinho saturava o message pump por quase 4 segundos.
            var progresso = new Progress<int>(processados => DespacharNaUi(() =>
            {
                _eventosExportados = processados;
                StateHasChanged();
            }));

            // Task.Run: o StreamWriter completa a escrita de forma síncrona enquanto o
            // buffer de 64 KB não enche, então sem isto a formatação de CSV/CLEF de todos
            // os eventos rodava na thread da UI até o primeiro flush real.
            await Task.Run(
                () => LogExporter.ExportToFileAsync(
                    paraExportar,
                    destino,
                    formato,
                    cts.Token,
                    progresso),
                cts.Token);

            Notifications.Success(
                $"{paraExportar.Length} eventos exportados",
                Path.GetFileName(destino));
        }
        catch (OperationCanceledException)
        {
            Notifications.Info("Exportação cancelada", "O arquivo de destino anterior foi preservado.");
        }
        catch (Exception ex)
        {
            AppLog.Error($"Falha ao exportar para '{destino}'", ex);
            Notifications.Error("Não foi possível exportar", ex.Message);
        }
        finally
        {
            Interlocked.CompareExchange(ref _exportCts, null, cts);
            cts.Dispose();
            _isExporting = false;
            StateHasChanged();
        }
    }

    private void CancelarExportacao()
    {
        var cts = Volatile.Read(ref _exportCts);
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { }
    }

