    }

    /// <summary>
    /// Dispara a filtragem a partir de contextos síncronos (setters de propriedade e
    /// handlers de evento). Descartar a Task é seguro porque <see cref="AplicarFiltrosAsync"/>
    /// trata as próprias exceções — ao contrário de um <c>async void</c>, cuja exceção
    /// escaparia para o contexto de sincronização e derrubaria a UI.
    /// </summary>
    private void AplicarFiltros() => _ = AplicarFiltrosAsync();

    private async Task AplicarFiltrosAsync()
    {
        long? geracaoProcessada = null;
        _consultasEmVoo++;

        try
        {
            // Só troca o conteúdo por um spinner quando não há NADA para trocar. Com a
            // lista preenchida, cada refiltragem — uma tecla na busca, um tick do modo ao
            // vivo — apagava por alguns quadros justamente o que o usuário estava lendo.
            if (_todosEventos.Count == 0) _isBusy = true;
            StateHasChanged();
            _ = AvisarSeDemorar();

            var criterios = new LogFilterCriteria
            {
                VisibleFiles = _visibleFiles,
                Levels = _niveisSelecionados.Count > 0 ? _niveisSelecionados : null,
                From = _dataInicial,
                To = PeriodoFiltro.FimDoMinuto(_dataFinal),
                Search = _textoPesquisa,
                UseRegex = _usarRegex,
                // O Store mantém os eventos ordenados e os filtros preservam a ordem
                // relativa, então não há por que reordenar tudo a cada filtragem.
                InputAlreadySorted = true,
            };

            // O Snapshot é o array publicado, sem cópia: a consulta pode enumerá-lo numa
            // thread do pool porque o Store SUBSTITUI a referência (carga nova, merge do
            // tail) em vez de mexer no array que já entregou. Ler aqui, e não dentro da
            // consulta, também fixa o conjunto desta geração.
            var resultado = await Consulta.ExecutarAsync(Store.Snapshot(), criterios);
            if (resultado is null) return;
            geracaoProcessada = resultado.Geracao;

            // Estatísticas FORA do dispatcher: rodando dentro do InvokeAsync abaixo, o
            // Compute custava 414 ms medidos com 1 milhão de eventos — a cada filtragem, e
            // uma vez por segundo com o modo ao vivo ligado. Era o maior travamento da
            // janela, e não a filtragem, que já roda em background.
            var geracaoStats = 0L;
            LogStats? estatisticas = null;
            if (ModoEstatisticas && Consulta.EstaAtual(resultado.Geracao))
            {
                geracaoStats = Interlocked.Increment(ref _geracaoEstatisticas);
                estatisticas = await CalcularEstatisticasAsync(resultado.Eventos);
            }

            await InvokeAsync(() =>
            {
                // A checagem precisa ocorrer dentro do callback: outra consulta pode começar
                // entre o término do trabalho em background e a vez deste callback na UI.
                if (!Consulta.EstaAtual(resultado.Geracao)) return;

                // Sem ToList: LogFilter.Apply já devolve uma List nova e não compartilhada,
                // então a cópia só duplicava 8 MB de referências por filtragem a 1M eventos.
                _todosEventos = resultado.Eventos as List<ClefEvent> ?? resultado.Eventos.ToList();
                _indiceSelecionado = -1;
                if (ModoTabela) DescobrirColunas();
                if (estatisticas is not null && Volatile.Read(ref _geracaoEstatisticas) == geracaoStats)
                {
                    _stats = estatisticas;
                }
            });
        }
        catch (OperationCanceledException)
        {
            // Filtragem substituída por outra mais recente — descarte esperado.
        }
        catch (FalhaConsultaLogsException ex)
        {
            if (!Consulta.EstaAtual(ex.Geracao)) return;
            if (ex.InnerException is RegexMatchTimeoutException)
            {
                Notifications.Warning(
                    "Expressão regular muito complexa",
                    "A busca foi interrompida para manter o aplicativo responsivo.");
            }
            else
            {
                AppLog.Error("Falha ao aplicar os filtros", ex.InnerException ?? ex);
                Notifications.Error("Não foi possível aplicar os filtros", ex.Message);
            }
        }
        catch (Exception ex)
        {
            if (geracaoProcessada is { } geracao && !Consulta.EstaAtual(geracao)) return;
            AppLog.Error("Falha ao atualizar a visualização filtrada", ex);
        }
        finally
        {
            // Todo caminho de saída passa por aqui — inclusive o `return` da consulta
            // substituída, que antes deixava o indicador ligado para sempre.
            FinalizarConsulta();
        }
    }

    /// <summary>
    /// Desliga os indicadores quando a ÚLTIMA consulta em voo termina. Com duas filtragens
    /// se sobrepondo (o debounce da busca dispara a segunda antes de a primeira responder),
    /// desligar no fim da primeira apagaria o aviso enquanto o trabalho continua.
    /// </summary>
    private void FinalizarConsulta()
    {
        if (--_consultasEmVoo > 0 || _descartado) return;

        _isBusy = false;
        _consultaDemorada = false;
        StateHasChanged();
    }

    /// <summary>
    /// Passado o limiar com a filtragem ainda em andamento, mostra o aviso e o botão de
    /// cancelar. Ordenar ou buscar em 1 milhão de eventos passa de um segundo, e até aqui
    /// não havia nem sinal de trabalho nem como desistir.
    /// </summary>
    private async Task AvisarSeDemorar()
    {
        await Task.Delay(LimiarDeDemora);

        if (_descartado || _consultasEmVoo == 0 || _consultaDemorada) return;
        _consultaDemorada = true;
        StateHasChanged();
    }

    /// <summary>Interrompe a filtragem/busca em andamento, mantendo o resultado anterior.</summary>
    private void CancelarFiltragem()
    {
        // A próxima filtragem pode ainda estar no debounce da busca: cancelar só a consulta
        // em voo deixaria o texto pendente disparar outra logo em seguida.
        var pendente = Volatile.Read(ref _debounceCts);
        if (pendente is not null)
        {
            try { pendente.Cancel(); } catch (ObjectDisposedException) { }
        }

        Consulta.CancelarConsultaAtual();
        Notifications.Info("Filtragem cancelada", "O resultado anterior continua na tela.");
    }


