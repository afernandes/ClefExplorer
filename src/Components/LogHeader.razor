<OmniAppBar Fixed="false">
    <OmniBrand Initial="C" Name="Clef Explorer" />

    <div class="clef-header-search">
        <OmniTextBox Value="@TextoPesquisa"
                     ValueChanged="OnSearchChanged"
                     LeadingIcon="search"
                     Clearable="true"
                     Placeholder="@(UsarRegex ? "Expressão regular..." : "Pesquisar nos logs (mensagem, correlação, exceção)...")" />

        @* Alterna entre busca literal e expressão regular. ".*" é a convenção
           usada por editores e navegadores para esse botão. *@
        <button type="button"
                class="clef-regex-toggle @(UsarRegex ? "is-active" : "") @(RegexInvalida ? "is-invalid" : "")"
                title="@(RegexInvalida ? "Expressão regular inválida" : "Usar expressão regular")"
                aria-pressed="@UsarRegex.ToString().ToLowerInvariant()"
                @onclick="ToggleRegex">.*</button>
    </div>

    @* O seletor de "itens por página" saiu junto com a paginação: lista e tabela
       virtualizam o conjunto filtrado inteiro, e a rolagem faz a navegação. *@
    <div class="clef-header-actions">
        <OmniAppearanceToggle />
    </div>
</OmniAppBar>

@code {
    [Parameter] public string TextoPesquisa { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextoPesquisaChanged { get; set; }

    [Parameter] public bool UsarRegex { get; set; }
    [Parameter] public EventCallback<bool> UsarRegexChanged { get; set; }

    /// <summary>Sinaliza no botão que o padrão digitado ainda não compila.</summary>
    [Parameter] public bool RegexInvalida { get; set; }

    [Parameter] public EventCallback OnReload { get; set; }

    private async Task OnSearchChanged(string? v)
    {
        TextoPesquisa = v ?? string.Empty;
        await TextoPesquisaChanged.InvokeAsync(TextoPesquisa);
    }

    private async Task ToggleRegex()
    {
        UsarRegex = !UsarRegex;
        await UsarRegexChanged.InvokeAsync(UsarRegex);
    }

}
