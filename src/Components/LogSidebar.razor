@using System.IO
@using ClefExplorer.Helpers
@using ClefExplorer.Models

<aside class="clef-sidebar">
    <div class="clef-sidebar-pad">
        <OmniPopover Open="_abrirOpen" OpenChanged="@(v => _abrirOpen = v)" ShowArrow="false" Offset="4" Width="240px" Class="clef-abrir-pop">
            <Trigger>
                <OmniButton Text="Abrir" Icon="folder" Variant="ButtonVariant.Primary" Block="true" />
            </Trigger>
            <ChildContent>
                <OmniMenu>
                    <OmniMenuItem Text="Arquivo .clef" Icon="file-text" OnClick="@(() => Exec(() => OnOpenFile.InvokeAsync()))" />
                    <OmniMenuItem Text="Pasta de logs" Icon="folder" OnClick="@(() => Exec(() => OnOpenFolder.InvokeAsync()))" />
                    @if (LogGroups != null && LogGroups.Any())
                    {
                        <OmniMenuSeparator />
                        @foreach (var group in LogGroups)
                        {
                            var g = group;
                            <OmniMenuItem Text="@g.Name" Icon="layers" OnClick="@(() => Exec(() => OnOpenGroup.InvokeAsync(g)))" />
                        }
                    }
                    <OmniMenuSeparator />
                    <OmniMenuItem Text="Gerenciar Grupos" Icon="settings" OnClick="@(() => Exec(() => OnManageGroups.InvokeAsync()))" />
                    <OmniMenuItem Text="Configurações" Icon="sliders" OnClick="@(() => Exec(() => OnOpenSettings.InvokeAsync()))" />
                </OmniMenu>
            </ChildContent>
        </OmniPopover>
    </div>

    <div class="clef-sidebar-scroll">
        <div class="clef-section-label">Filtros Rápidos</div>
        <div class="clef-filters">
            @* "Todos" limpa a seleção; os demais alternam, permitindo combinar níveis
               (ex.: Erros + Avisos) — antes só dava para escolher um. *@
            <button type="button" class="clef-filter @(NenhumNivelSelecionado ? "is-active" : "")"
                    @onclick="LimparNiveis">
                <OmniIcon Name="inbox" Size="ComponentSize.Sm" />
                <span>Todos</span>
            </button>
            @foreach (var grupo in Grupos)
            {
                var g = grupo;
                <button type="button" class="clef-filter @g.Css @(GrupoAtivo(g) ? "is-active" : "")"
                        @onclick="() => AlternarGrupo(g)">
                    <OmniIcon Name="@g.Icone" Size="ComponentSize.Sm" />
                    <span>@g.Rotulo</span>
                </button>
            }
        </div>

        @* ShowTime: em log, recortar um pico de erro costuma ser questão de minutos, não
           de dias. O filtro compara o instante completo — ver LogFilter.From/To. *@
        <div class="clef-section-label">Período</div>
        <div class="clef-period">
            <div>
                <div class="clef-field-label">De:</div>
                <OmniDatePicker TValue="DateTime?" Value="DataInicial" ValueChanged="OnDataInicialChanged"
                                ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Clearable="true"
                                Placeholder="dd/mm/aaaa hh:mm" />
            </div>
            <div>
                <div class="clef-field-label">Até:</div>
                <OmniDatePicker TValue="DateTime?" Value="DataFinal" ValueChanged="OnDataFinalChanged"
                                ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Clearable="true"
                                Placeholder="dd/mm/aaaa hh:mm" />
            </div>
        </div>

        @if (AvailableFiles != null && AvailableFiles.Any())
        {
            <div class="clef-section-label">Arquivos Carregados</div>

            @* Fora do .clef-tree (que rola): uma pasta com dezenas de logs empurraria o
               campo de busca para fora da vista justamente quando ele é mais útil. *@
            <div class="clef-tree-search">
                <OmniTextBox Value="@_buscaArquivos"
                             ValueChanged="OnBuscaArquivosChanged"
                             LeadingIcon="search"
                             Clearable="true"
                             Size="ComponentSize.Sm"
                             Placeholder="Localizar arquivo..." />
            </div>

            <div class="clef-tree">
                <LogFileTree Files="@AvailableFiles"
                             CheckedFiles="@(VisibleFiles ?? LoadedFiles)"
                             OnSelectionChanged="OnSelectionChanged"
                             Filtro="@_buscaArquivos" />
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public HashSet<string> NiveisSelecionados { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback<HashSet<string>> NiveisSelecionadosChanged { get; set; }

    [Parameter] public HashSet<string>? VisibleFiles { get; set; }
    [Parameter] public EventCallback<HashSet<string>?> VisibleFilesChanged { get; set; }

    [Parameter] public DateTime? DataInicial { get; set; }
    [Parameter] public EventCallback<DateTime?> DataInicialChanged { get; set; }

    [Parameter] public DateTime? DataFinal { get; set; }
    [Parameter] public EventCallback<DateTime?> DataFinalChanged { get; set; }

    [Parameter] public IEnumerable<string> LoadedFiles { get; set; } = Enumerable.Empty<string>();
    [Parameter] public IEnumerable<string> AvailableFiles { get; set; } = Enumerable.Empty<string>();
    [Parameter] public IEnumerable<LogGroup> LogGroups { get; set; } = Enumerable.Empty<LogGroup>();

    [Parameter] public EventCallback OnOpenFile { get; set; }
    [Parameter] public EventCallback OnOpenFolder { get; set; }
    [Parameter] public EventCallback<LogGroup> OnOpenGroup { get; set; }
    [Parameter] public EventCallback OnManageGroups { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    private bool _abrirOpen;

    /// <summary>
    /// Termo do campo de busca da árvore. Mora aqui, e não no <c>LogFileTree</c>, porque o
    /// campo fica fora da área que rola — e some junto com a árvore quando não há arquivos.
    /// </summary>
    private string _buscaArquivos = string.Empty;

    private void OnBuscaArquivosChanged(string? valor) => _buscaArquivos = valor ?? string.Empty;

    /// <summary>Fecha o popover e dispara a ação do item escolhido.</summary>
    private async Task Exec(Func<Task> action)
    {
        _abrirOpen = false;
        await action();
    }

    /// <summary>Um botão de filtro e os níveis do Serilog que ele representa.</summary>
    private sealed record GrupoNivel(string Rotulo, string Icone, string Css, string[] Niveis);

    // "Erros" cobre Error e Fatal — um Fatal não pode escapar de quem procura erros.
    private static readonly GrupoNivel[] Grupos =
    {
        new("Erros", "alert-circle", "clef-filter-error", new[] { "Error", "Fatal" }),
        new("Avisos", "alert-triangle", "clef-filter-warn", new[] { "Warning" }),
        new("Informações", "info", "clef-filter-info", new[] { "Information" }),
        new("Debug", "bug", "clef-filter-debug", new[] { "Debug" }),
        new("Verbose", "list", "clef-filter-verbose", new[] { "Verbose" }),
    };

    private bool NenhumNivelSelecionado => NiveisSelecionados.Count == 0;

    private bool GrupoAtivo(GrupoNivel grupo) => grupo.Niveis.All(NiveisSelecionados.Contains);

    private async Task LimparNiveis()
    {
        if (NenhumNivelSelecionado) return;
        await AtualizarNiveis(new HashSet<string>(StringComparer.OrdinalIgnoreCase));
    }

    private async Task AlternarGrupo(GrupoNivel grupo)
    {
        var novos = new HashSet<string>(NiveisSelecionados, StringComparer.OrdinalIgnoreCase);

        if (GrupoAtivo(grupo))
        {
            foreach (var nivel in grupo.Niveis) novos.Remove(nivel);
        }
        else
        {
            foreach (var nivel in grupo.Niveis) novos.Add(nivel);
        }

        await AtualizarNiveis(novos);
    }

    private async Task AtualizarNiveis(HashSet<string> niveis)
    {
        NiveisSelecionados = niveis;
        await NiveisSelecionadosChanged.InvokeAsync(niveis);
    }

    private async Task OnSelectionChanged(HashSet<string> selectedFiles)
    {
        VisibleFiles = selectedFiles;
        await VisibleFilesChanged.InvokeAsync(VisibleFiles);
    }

    private async Task OnDataInicialChanged(DateTime? value)
    {
        DataInicial = value;
        await DataInicialChanged.InvokeAsync(value);
    }

    private async Task OnDataFinalChanged(DateTime? value)
    {
        // Escolher só o dia no calendário deixaria "Até" em 00:00, descartando o dia todo.
        value = PeriodoFiltro.FimDoDiaAoTrocarDeData(value, DataFinal);
        DataFinal = value;
        await DataFinalChanged.InvokeAsync(value);
    }
}
